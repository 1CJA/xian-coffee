/* 小程序全局样式：定义全局背景、字体和通用布局。 */
/* 全局页面：统一背景和字体。 */
page {
  min-height: 100vh;
  color: #2b211b;
  background: #f7efe7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

.safe-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

.tap-scale {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.tap-scale:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.primary-button {
  height: 96rpx;
  border-radius: 48rpx;
  background: #6f4b35;
  color: #fff7ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 34rpx rgba(111, 75, 53, 0.26);
}

.ghost-button {
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(111, 75, 53, 0.34);
  color: #6f4b35;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  background: rgba(255, 250, 244, 0.74);
}
