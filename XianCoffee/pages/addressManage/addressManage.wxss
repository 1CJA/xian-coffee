/* 地址管理页样式：控制地址卡片、按钮和页面布局。 */
/* 页面样式配置 */
/* 页面基础样式：设置背景色、字体颜色和最小高度。 */
page {
  min-height: 100vh;
  background: #F4EAD9;
  color: #3f442f;
}

/* 页面主容器：控制整体间距、背景和安全区域。 */
.address-page {
  min-height: 100vh;
  padding: 70rpx 28rpx 42rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

/* 地址区域：控制地址卡片、默认标识和操作按钮。 */
.address-shell {
  min-height: calc(100vh - 112rpx);
  padding: 0 18rpx 34rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

.topbar {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn,
.top-space {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.page-title {
  color: #3f442f;
  font-size: 42rpx;
  line-height: 54rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

/* 品牌元素：控制 logo、标题和英文标识样式。 */
.brand-area {
  position: relative;
  height: 214rpx;
  margin-top: 16rpx;
}

.brand-center {
  position: absolute;
  left: 136rpx;
  top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.brand-row {
  display: flex;
  align-items: center;
}

.leaf {
  width: 42rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.leaf.left {
  margin-right: 34rpx;
}

.leaf.right {
  width: 48rpx;
  height: 62rpx;
  margin-left: 34rpx;
}

.brand-name {
  color: #3f442f;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 900;
  letter-spacing: 9rpx;
  white-space: nowrap;
}

.brand-en {
  margin-top: 8rpx;
  color: #3f442f;
  font-size: 21rpx;
  line-height: 28rpx;
  letter-spacing: 8rpx;
}

.coffee-img {
  position: absolute;
  left: 440rpx;
  right: 0;
  top: 30rpx;
  width: 318rpx;
  height: 160rpx;
  z-index: 1;
}

.address-list {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.address-card {
  min-height: 206rpx;
  padding: 28rpx 24rpx 24rpx;
  border: 2rpx solid rgba(205, 183, 142, 0.68);
  border-radius: 22rpx;
  background: rgba(255, 250, 239, 0.42);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.location-side {
  width: 94rpx;
  min-height: 142rpx;
  border-right: 2rpx solid rgba(210, 190, 151, 0.48);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
}

.location-icon {
  width: 58rpx;
  height: 78rpx;
}

.vertical-dash {
  width: 2rpx;
  height: 84rpx;
  margin-top: 8rpx;
  background-image: linear-gradient(to bottom, rgba(211, 190, 151, 0.74) 0, rgba(211, 190, 151, 0.74) 10rpx, transparent 10rpx, transparent 22rpx);
  background-size: 2rpx 22rpx;
}

.info-block {
  min-width: 0;
  flex: 1;
  padding-left: 36rpx;
  padding-right: 20rpx;
  display: flex;
  flex-direction: column;
}

.name-row {
  display: flex;
  align-items: center;
}

.person-name {
  color: #3f442f;
  font-size: 37rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.default-tag {
  height: 38rpx;
  margin-left: 30rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(200, 178, 137, 0.75);
  border-radius: 14rpx;
  background: #eee0c8;
  color: #65583d;
  font-size: 22rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.phone-text {
  margin-top: 18rpx;
  color: #4d533c;
  font-size: 32rpx;
  line-height: 40rpx;
  letter-spacing: 2rpx;
}

.detail-text {
  margin-top: 18rpx;
  color: #52543f;
  font-size: 27rpx;
  line-height: 39rpx;
  white-space: pre-line;
}

/* 操作按钮：控制页面内按钮排列和状态。 */
.action-block {
  width: 176rpx;
  height: 92rpx;

  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

.action-item {
  width: 76rpx;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #535640;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.action-item.delete {
  color: #8a5736;
}

.action-icon {
  width: 43rpx;
  height: 43rpx;
  margin-bottom: 8rpx;
}

.action-icon.edit {
  width: 45rpx;
  height: 45rpx;
}

.action-line {
  display: none;
}

.add-btn {
  height: 90rpx;
  margin: 150rpx 80rpx 0;
  border-radius: 999rpx;
  background: #75825f;
  color: #fff8ec;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

.plus-icon {
  width:120rpx;
  height: 130rpx;
  filter: brightness(2.2);
}

@media (max-width: 360px) {
  .address-page {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .address-shell {
    padding-left: 10rpx;
    padding-right: 10rpx;
  }

  .brand-center {
    left: 106rpx;
  }

  .coffee-img {
    width: 190rpx;
  }

  .address-card {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .info-block {
    padding-left: 24rpx;
  }

  .action-block {
    width: 156rpx;
  }
}