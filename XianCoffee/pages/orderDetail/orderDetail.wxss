/* 订单详情页样式：控制订单详情卡片和金额区域。 */
/* 页面样式配置 */
/* 页面基础样式：设置背景色、字体颜色和最小高度。 */
page {
  min-height: 100vh;
  background: #F4EAD9;
  color: #3f422d;
}

/* 页面主容器：控制整体间距、背景和安全区域。 */
.detail-page {
  min-height: 100vh;
  padding: 86rpx 30rpx 178rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

/* 顶部区域：控制标题、品牌和右侧操作的排版。 */
/* 顶部区域：控制标题、品牌和操作入口排版。 */
.detail-header {
  height: 76rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 48rpx;
  height: 42rpx;
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  flex-shrink: 0;
}

.title-wrap {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.title-leaf {
  width: 38rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.title-leaf.left {
  transform: rotate(-36deg);
}

.title-leaf.right {
  transform: rotate(36deg) scaleX(-1);
}

.page-title {
  color: #3f442f;
  font-size: 44rpx;
  line-height: 54rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
}

.status-card,
.info-card,
.goods-card,
.amount-card,
.remark-card {
  border: 2rpx solid rgba(204, 182, 144, 0.62);
  border-radius: 24rpx;
  background: rgba(255, 250, 239, 0.36);
  box-sizing: border-box;
}

.status-card {
  min-height: 260rpx;
  margin-top: 28rpx;
  padding: 34rpx 26rpx 26rpx 34rpx;
  display: flex;
  overflow: hidden;
}

.status-copy {
  width: 260rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.status-tag {
  width: 152rpx;
  height: 66rpx;
  border-radius: 12rpx;
  background: #74805d;
  color: #fff8ec;
  font-size: 34rpx;
  line-height: 66rpx;
  text-align: center;
  font-weight: 900;
}

.pickup-time {
  margin-top: 30rpx;
  color: #667050;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.status-desc {
  margin-top: 14rpx;
  color: #726a5a;
  font-size: 24rpx;
  line-height: 34rpx;
}

.status-desc + .status-desc {
  margin-top: 0;
}

/* 门店区域：控制门店图片、地址和营业信息。 */
.store-hero {
  flex: 1;
  height: 228rpx;
  align-self: flex-end;
}

/* 订单区域：控制订单卡片、状态和商品明细。 */
/* 订单区域：控制订单卡片、状态和明细布局。 */
.order-code-card {
  min-height: 194rpx;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
}

.order-info-list {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
  border-right: 2rpx dashed rgba(190, 170, 136, 0.58);
}

.info-row {
  height: 48rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info-label {
  width: 112rpx;
  color: #3f422d;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #55513f;
  font-size: 25rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-panel {
  width: 188rpx;
  flex-shrink: 0;
  padding-left: 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.code-label {
  color: #3f422d;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.code-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
}

.code-num {
  color: #647153;
  font-size: 38rpx;
  line-height: 54rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.copy-btn {
  width: 66rpx;
  height: 42rpx;
  border: 2rpx solid rgba(153, 130, 94, 0.54);
  border-radius: 22rpx;
  color: #7b705e;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

.code-desc {
  margin-top: 10rpx;
  color: #7b7362;
  font-size: 21rpx;
  line-height: 28rpx;
  white-space: normal;
}

.store-card {
  min-height: 140rpx;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
}

.store-text {
  flex: 1;
  min-width: 0;
}

.store-title-row,
.distance-row {
  display: flex;
  align-items: center;
}

.store-small-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.store-title {
  color: #3f422d;
  font-size: 31rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.store-address {
  display: block;
  margin: 12rpx 0 12rpx 58rpx;
  color: #6e6658;
  font-size: 25rpx;
  line-height: 32rpx;
}

.distance-icon {
  width: 50rpx;
  height:70rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.distance-row {
  color: #6e6658;
  font-size: 25rpx;
  line-height: 32rpx;
}

.store-actions {
  width: 180rpx;
  display: flex;
  justify-content: space-between;
  flex-shrink: 0;
}

.circle-action {
  width: 78rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #6e6658;
  font-size: 23rpx;
  line-height: 30rpx;
}

.circle-icon {
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 8rpx;
}

.goods-card {
  margin-top: 20rpx;
  padding: 22rpx 24rpx 8rpx;
}

.section-head {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #3f422d;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.goods-count {
  color: #6e6658;
  font-size: 25rpx;
  font-weight: 500;
}

.goods-item {
  min-height: 150rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(204, 182, 144, 0.42);
  display: flex;
  align-items: center;
}

.goods-item.last {
  border-bottom: 0;
}

.goods-img {
  width: 182rpx;
  height: 120rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.goods-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods-name {
  color: #3f422d;
  font-size: 33rpx;
  line-height: 40rpx;
  font-weight: 900;
}



.goods-remark {
  margin-top: 8rpx;
  color: #a06442;
  font-size: 24rpx;
  line-height: 30rpx;
}

.goods-price-box {
  width: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.goods-price {
  color: #3f422d;
  font-size: 27rpx;
  line-height: 34rpx;
}

.goods-qty {
  margin-top: 32rpx;
  color: #6e6658;
  font-size: 24rpx;
  line-height: 30rpx;
}

.amount-card {
  margin-top: 0;
  padding: 22rpx 26rpx;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
}

.amount-row {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #3f422d;
  font-size: 28rpx;
  line-height: 36rpx;
}

.amount-row.coupon {
  color: #b45539;
}

.amount-row.coupon view {
  color: #3f422d;
  display: flex;
  align-items: center;
}

/* 优惠券区域：控制券面、金额和使用状态样式。 */
/* 优惠券区域：控制券面、金额和使用状态。 */
.coupon-tag {
  margin-left: 18rpx;
  min-width: 86rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border: 2rpx solid rgba(194, 164, 118, 0.58);
  border-radius: 16rpx;
  color: #8c7250;
  font-size: 22rpx;
  line-height: 30rpx;
  box-sizing: border-box;
}

.amount-line {
  height: 2rpx;
  margin: 16rpx 0;
  background: rgba(204, 182, 144, 0.44);
}

.amount-row.paid {
  font-size: 31rpx;
  font-weight: 900;
}

.amount-row.paid text:last-child {
  color: #627052;
  font-size: 48rpx;
}

.remark-card {
  min-height: 96rpx;
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
}

.remark-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.remark-copy {
  display: flex;
  flex-direction: column;
}

.remark-title {
  color: #3f422d;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.remark-text {
  margin-top: 10rpx;
  color: #726a5a;
  font-size: 23rpx;
  line-height: 30rpx;
}

.bottom-actions {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 78rpx;
  display: flex;
  gap: 32rpx;
  z-index: 20;
}

.again-action,
.service-action {
  flex: 1;
  height: 78rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 31rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.again-action {
  border: 2rpx solid #5d674b;
  color: #3f422d;
  background: #F4EAD9;
}

.service-action {
  color: #fff8ec;
  background: #74805d;
}

@media (max-width: 360px) {
  .detail-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }.goods-img {
    width: 160rpx;
    margin-right: 20rpx;
  }

  .code-panel {
    width: 178rpx;
    padding-left: 18rpx;
  }
}