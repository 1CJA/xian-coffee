/* 个人中心页样式：控制头像、统计卡片和功能列表。 */
/* 页面样式配置 */
/* 页面基础样式：设置背景色、字体颜色和最小高度。 */
page {
  min-height: 100vh;
  background: #F4EAD9;
  color: #414633;
}

/* 页面主容器：控制整体间距、背景和安全区域。 */
.profile-page {
  min-height: 100vh;
  padding: 48rpx 28rpx 178rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

.profile-shell {
  min-height: calc(100vh - 226rpx);
  padding: 42rpx 28rpx 32rpx;
  border-radius: 58rpx 58rpx 0 0;
  box-sizing: border-box;
  background: #F4EAD9;
  box-shadow: none;
}

/* 顶部区域：控制标题、品牌和右侧操作的排版。 */
/* 顶部区域：控制标题、品牌和操作入口排版。 */
.profile-header {
  position: relative;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.title-leaf {
  width: 36rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.title-leaf.left {
  transform: rotate(-34deg);
}

.title-leaf.right {
  transform: rotate(34deg) scaleX(-1);
}

.page-title {
  color: #3f452d;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
  letter-spacing: 12rpx;
}

.notice-icon {
  position: absolute;
  right: 8rpx;
  top: 14rpx;
  width: 52rpx;
  height: 52rpx;
}

.user-hero {
  position: relative;
  height: 312rpx;
  margin-top: 22rpx;
  overflow: visible;
}

.avatar-img {
  position: absolute;
  left: 0;
  top: 62rpx;
  width: 178rpx;
  height: 178rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F4EAD9;
  z-index: 2;
}

.user-info {
  position: absolute;
  left: 214rpx;
  top: 72rpx;
  width: 262rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  max-width: 194rpx;
  color: #3c432c;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
  white-space: nowrap;
}

.vip-tag {
  min-width: 62rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #77835f;
  color: #fff8ea;
  font-size: 25rpx;
  line-height: 38rpx;
  font-weight: 800;
  text-align: center;
}

.welcome-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  color: #6f6757;
  font-size: 27rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.small-leaf {
  width: 30rpx;
  height: 34rpx;
  margin-left: 10rpx;
  transform: rotate(18deg);
}

.points-pill {
  height: 58rpx;
  margin-top: 22rpx;
  padding: 0 20rpx 0 20rpx;
  border-radius: 30rpx;
  background: rgba(229, 216, 191, 0.88);
  color: #756c5c;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.points-num {
  color: #4d5138;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.arrow {
  color: #5f6248;
  font-size: 42rpx;
  line-height: 42rpx;
}

.scene-img {
  position: absolute;
  right: -33rpx;
  top: 5rpx;
  width: 360rpx;
  height: 340rpx;
  z-index: 1;
}

/* 订单区域：控制订单卡片、状态和商品明细。 */
.order-card,
.service-card {
  border: 2rpx solid rgba(204, 184, 150, 0.66);
  border-radius: 26rpx;
  background: rgba(255, 250, 239, 0.34);
  box-sizing: border-box;
}

/* 订单区域：控制订单卡片、状态和明细布局。 */
.order-card {
  padding: 28rpx 28rpx 26rpx;
}

.section-head {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #3e442e;
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.view-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #6d6658;
  font-size: 27rpx;
  line-height: 34rpx;
}

.order-status-row {
  margin-top: 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.status-item {
  width: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-icon-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-icon {
  width: 92rpx;
  height: 92rpx;
}



.status-name {
  margin-top: 14rpx;
  color: #575641;
  font-size: 25rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.service-card {
  margin-top: 24rpx;
  padding: 0 28rpx;
}

.service-row {
  height: 98rpx;
  border-bottom: 2rpx dashed rgba(191, 170, 132, 0.52);
  display: flex;
  align-items: center;
}

.service-row.last {
  border-bottom: none;
}

.service-icon {
  width: 68rpx;
  height: 68rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.service-name {
  color: #3f4430;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.service-extra {
  margin-left: auto;
  color: #766e5f;
  font-size: 25rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.service-arrow {
  margin-left: 18rpx;
  color: #68634f;
  font-size: 44rpx;
  line-height: 44rpx;
}

.benefit-card {
  position: relative;
  height: 230rpx;
  margin-top: 26rpx;
  padding: 32rpx 34rpx;
  border-radius: 24rpx;
  background: #d7d0ad;
  overflow: hidden;
  box-sizing: border-box;
}

.benefit-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.benefit-title {
  color: #3f4b32;
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.benefit-desc {
  margin-top: 12rpx;
  color: #68624f;
  font-size: 25rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.benefit-btn {
  width: 154rpx;
  height: 52rpx;
  margin-top: 18rpx;
  border-radius: 30rpx;
  background: #74805c;
  color: #fff8ea;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.benefit-img {
  position: absolute;
  right: -18rpx;
  bottom: -4rpx;
  width: 334rpx;
  height: 218rpx;
  z-index: 1;
}

/* 底部导航：控制 tab 图标、文字和选中状态。 */
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  padding: 18rpx 34rpx calc(16rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  border-top: 2rpx solid rgba(205, 187, 151, 0.46);
  background: #fff8ea;
  box-shadow: 0 -10rpx 28rpx rgba(84, 70, 44, 0.1);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  z-index: 40;
}

.nav-item {
  width: 112rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5e5847;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.nav-item.active {
  color: #4f5e40;
  font-weight: 900;
}

.nav-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

@media (max-width: 360px) {
  .profile-page {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .profile-shell {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .scene-img {
    width: 290rpx;
    right: -26rpx;
  }

  .user-info {
    left: 200rpx;
  }

  .status-item {
    width: 104rpx;
  }
}