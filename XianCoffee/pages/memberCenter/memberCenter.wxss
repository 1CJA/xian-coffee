/* 会员中心页样式：控制会员卡、权益区和列表布局。 */
/* 页面样式配置 */
/* 页面基础样式：设置背景色、字体颜色和最小高度。 */
page {
  min-height: 100vh;
  background: #F4EAD9;
  color: #3f422d;
}

/* 页面主容器：控制整体间距、背景和安全区域。 */
.member-page {
  min-height: 100vh;
  padding: 66rpx 18rpx 166rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

.topbar {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.top-btn,
.top-placeholder {
  width: 72rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 44rpx;
  height: 44rpx;
}

.top-title {
  color: #3f422d;
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.vip-card {
  position: relative;
  height: 368rpx;
  margin-top: 8rpx;
  padding: 36rpx 40rpx;
  border-radius: 22rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(135deg, #8b9071 0%, #777d5f 58%, #6c7558 100%);
  box-shadow: 0 10rpx 24rpx rgba(72, 63, 42, 0.18);
}

.vip-card::after {
  content: '';
  position: absolute;
  left: 90rpx;
  top: 118rpx;
  width: 310rpx;
  height: 210rpx;
  border: 3rpx solid rgba(244, 234, 217, 0.08);
  border-radius: 55% 45% 60% 40%;
  transform: rotate(-24deg);
}

.card-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.card-number {
  align-self: flex-end;
  color: rgba(255, 250, 237, 0.78);
  font-size: 21rpx;
  line-height: 26rpx;
  letter-spacing: 1rpx;
}

/* 品牌元素：控制 logo、标题和英文标识样式。 */
.brand-name {
  margin-top: 4rpx;
  color: #fff8ec;
  font-size: 42rpx;
  line-height: 54rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.brand-en {
  color: rgba(255, 250, 237, 0.88);
  font-size: 25rpx;
  line-height: 31rpx;
  letter-spacing: 8rpx;
}

.level-row {
  width: 220rpx;
  height: 45rpx;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
}

.vip-chip {
  width: 70rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: #f4ead9;
  color: #777558;
  font-size: 25rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 900;
}

.level-text {
  margin-left: 20rpx;
  color: rgba(255, 250, 237, 0.88);
  font-size: 24rpx;
  line-height: 30rpx;
}

.life-text {
  position: absolute;
  left: 0;
  top: 246rpx;
  color: rgba(255, 250, 237, 0.74);
  font-size: 25rpx;
  line-height: 34rpx;
  letter-spacing: 2rpx;
}

.card-coffee {
  position: absolute;
  left: 440rpx;
  top: 15rpx;
  width: 300rpx;
  height: 352rpx;
  z-index: 3;
}

.points-block {
  position: absolute;
  right: 165rpx;
  bottom: 31rpx;
  z-index: 4;
  color: #fff8ec;
}

.points-label {
  display: block;
  font-size: 24rpx;
  line-height: 30rpx;
  letter-spacing: 2rpx;
}

.points-line {
  display: flex;
  align-items: baseline;
}

.points-number {
  font-size: 54rpx;
  line-height: 70rpx;
  font-weight: 800;
}

.points-unit {
  margin-left: 10rpx;
  font-size: 23rpx;
}

.points-arrow {
  margin-left: 30rpx;
  font-size: 42rpx;
  line-height: 46rpx;
}

.asset-strip {
  height: 166rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(211, 189, 150, 0.62);
  border-radius: 20rpx;
  background: rgba(255, 250, 239, 0.56);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.asset-item {
  flex: 1;
  height: 96rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  box-sizing: border-box;
}

.asset-item + .asset-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 2rpx;
  background: rgba(208, 188, 148, 0.44);
}

.asset-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.asset-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.asset-label {
  color: #55533e;
  font-size: 22rpx;
  line-height: 28rpx;
  white-space: nowrap;
}

.asset-value {
  margin-top: 2rpx;
  color: #4b4f39;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 800;
}



.feature-grid {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
}

.feature-card {
  width: calc((100% - 24rpx) / 2);
  height: 290rpx;
  padding: 27rpx 24rpx 16rpx;
  border: 2rpx solid rgba(210, 190, 151, 0.52);
  border-radius: 18rpx;
  background: rgba(255, 250, 239, 0.34);
  box-sizing: border-box;
  overflow: hidden;
}

.feature-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.feature-title,
.feature-subtitle {
  display: block;
}

.feature-title {
  color: #55533e;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.feature-subtitle {
  margin-top: 8rpx;
  color: #6f6654;
  font-size: 24rpx;
  line-height: 30rpx;
  letter-spacing: 2rpx;
}

.feature-arrow {
  color: #575a43;
  font-size: 44rpx;
  line-height: 42rpx;
}

/* 集点区域：控制集点卡、圆点和记录列表。 */
.stamp-image {
  width: 300rpx;
  height: 158rpx;
  margin: 12rpx 0 0 8rpx;
}

.benefit-image {
  width: 330rpx;
  height: 156rpx;
  margin: 8rpx 0 0 0;
}

/* 会员区域：控制会员卡、积分、余额和权益入口。 */
.member-day {
  height: 234rpx;
  margin-top: 24rpx;
  padding: 29rpx 0 22rpx 36rpx;
  border: 2rpx solid rgba(210, 190, 151, 0.48);
  border-radius: 18rpx;
  background: #b4c591;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.member-day-copy {
  position: relative;
  z-index: 2;
}

.member-day-title {
  color: #4f543d;
  font-size: 39rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.discount-line {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  color: #5e5847;
  font-size: 25rpx;
  line-height: 31rpx;
}

.discount-number {
  color: #4c5139;
  font-size: 31rpx;
  font-weight: 900;
}

.detail-pill {
  width: 150rpx;
  height: 48rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #747d5f;
  color: #fff8ec;
  font-size: 24rpx;
  line-height: 48rpx;
  text-align: center;
  font-weight: 700;
}

.member-day-image {
  position: absolute;
  left:320rpx;
  bottom: 10rpx;
  width: 420rpx;
  height: 213rpx;
}

.orders-section {
  margin-top: 18rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #454936;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.all-orders {
  color: #696451;
  font-size: 23rpx;
  line-height: 34rpx;
}

.status-row {
  height: 136rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-item {
  width: 122rpx;
  height: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #4f4d3b;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.status-icon {
  width: 74rpx;
  height: 74rpx;
  margin-bottom: 10rpx;
}

/* 底部导航：控制 tab 图标、文字和选中状态。 */
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  padding: 18rpx 34rpx calc(16rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  border-top: 2rpx solid rgba(205, 187, 151, 0.46);
  background: #fff8ea;
  box-shadow: 0 -10rpx 28rpx rgba(84, 70, 44, 0.1);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  z-index: 20;
}

.nav-item {
  width: 112rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5e5847;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.nav-item.active {
  color: #4f5e40;
  font-weight: 900;
}

.nav-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

@media (max-width: 360px) {
  .member-page {
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .vip-card {
    padding-left: 30rpx;
  }

  .card-coffee {
    right: 14rpx;
    width: 266rpx;
    height: 300rpx;
  }

  .asset-icon {
    width: 52rpx;
    height: 62rpx;
  }

  .asset-label {
    font-size: 19rpx;
  }

  .asset-value {
    font-size: 30rpx;
  }
}