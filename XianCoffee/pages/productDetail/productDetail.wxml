<!-- 商品详情页结构：展示商品图片、规格选项和底部按钮。 -->
<!-- 页面结构布局 -->
<!-- 页面主容器：包裹当前页面的全部内容。 -->
<view class="detail-page">
  <!-- 顶部栏：返回、标题和分享。 -->
  <view class="top-bar">
    <view class="back-btn" bindtap="goBack"></view>
    <view class="brand-title">
      <text class="brand-name">栖岸咖啡</text>
      <text class="brand-en">QI'AN COFFEE</text>
    </view>
    <image class="share-btn" src="{{shareIcon}}" mode="aspectFit" bindtap="handleShareTap"></image>
  </view>

  <!-- 商品主图区：展示大图。 -->
  <view class="hero-card" bindtap="handleHeroTap">
    <image class="hero-image" src="{{heroImage}}" mode="aspectFit"></image>
  </view>

  <!-- 商品信息区：名称和价格。 -->
  <view class="product-head">
    <view class="title-wrap">
      <text class="product-name">{{product.name}}</text>
      <text class="recommend-tag">店长推荐</text>
    </view>
    <view class="price-wrap">
      <text class="price-symbol">¥</text>
      <text class="price-num">{{currentPrice}}</text>
    </view>
  </view>

  <text class="product-desc">{{product.detailDesc}}</text>

  <view class="divider"></view>

  <!-- 规格选择区：温度杯型等。 -->
  <view class="option-group option-group-{{item.key}}" wx:for="{{optionGroups}}" wx:key="key">
    <view class="option-row">
      <view class="option-label">
        <text class="option-title">{{item.title}}</text>
        <text class="option-en">{{item.en}}</text>
      </view>
      <view class="option-list option-list-{{item.key}}">
        <view
          wx:for="{{item.options}}"
          wx:for-item="option"
          wx:key="value"
          class="option-pill {{selectedOptions[item.key] === option.value ? 'active' : ''}} {{option.more && showMoreExtra ? 'active' : ''}} {{option.wide ? 'wide' : ''}} {{option.more ? 'more' : ''}}"
          data-group="{{item.key}}"
          data-value="{{option.value}}"
          bindtap="handleOptionTap"
        >
          <text>{{option.label}}</text>
          <image wx:if="{{option.icon}}" class="option-icon" src="{{option.icon}}" mode="aspectFit"></image>
          <text wx:if="{{option.more}}" class="more-arrow">⌄</text>
        </view>
      </view>
    </view>

    <!-- 更多加料区：展开隐藏选项。 -->
    <view wx:if="{{item.key === 'extra' && showMoreExtra}}" class="extra-more-panel">
      <view
        wx:for="{{extraMoreOptions}}"
        wx:for-item="more"
        wx:key="value"
        class="extra-more-pill {{selectedOptions.extra === more.value ? 'active' : ''}}"
        data-value="{{more.value}}"
        bindtap="handleExtraMoreTap"
      >{{more.label}}</view>
    </view>
  </view>

  <!-- 产品介绍区：展示说明图文。 -->
  <view class="about-card" bindtap="handleAboutTap">
    <view class="about-copy">
      <view class="about-title-row">
        <text class="about-title">产品介绍</text>
        <text class="about-en">ABOUT</text>
      </view>
      <text class="about-text">精选100%阿拉比卡咖啡豆，深度烘焙后萃取出浓郁的咖啡风味，搭配新鲜牛奶，奶泡细腻绵密，入口顺滑，香气平衡。</text>
    </view>
    <image class="about-image" src="{{aboutImage}}" mode="aspectFit"></image>
  </view>

  <!-- 底部操作区：数量和加购。 -->
  <view class="bottom-bar">
    <view class="quantity-box">
      <view class="step-btn" bindtap="handleMinusTap">−</view>
      <text class="quantity-num">{{quantity}}</text>
      <view class="step-btn" bindtap="handlePlusTap">＋</view>
    </view>
    <view class="add-cart-btn" bindtap="handleAddCartTap">
      <image class="cart-icon" src="{{cartIcon}}" mode="aspectFit"></image>
      <text class="add-text">加入购物车</text>
      <text class="add-price">¥{{currentPrice}}</text>
    </view>
  </view>
</view>