/* 购物袋页样式：控制商品卡片、底部结算和滚动区域。 */
/* 页面样式配置 */
/* 页面基础样式：设置背景色、字体颜色和最小高度。 */
page {
  min-height: 100vh;
  background: #F4EAD9;
  color: #41452d;
}

/* 页面主容器：控制整体间距、背景和安全区域。 */
.cart-page {
  min-height: 100vh;
  padding: 76rpx 30rpx 420rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

/* 顶部区域：控制标题、品牌和右侧操作的排版。 */
/* 顶部区域：控制标题、品牌和操作入口排版。 */
.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

/* 品牌元素：控制 logo、标题和英文标识样式。 */
.brand-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-leaf {
  width: 56rpx;
  height: 84rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}


.brand-back {
  width: 50rpx;
  height: 50rpx;
  margin-right: 12rpx;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 38rpx;
  line-height: 42rpx;
  font-weight: 900;
  letter-spacing: 7rpx;
  white-space: nowrap;
}

.brand-en {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 20rpx;
  letter-spacing: 5rpx;
  white-space: nowrap;
}

.page-title {
  position: absolute;
  left: 50%;
  top: 94rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.title-line {
  width: 42rpx;
  height: 6rpx;
  margin-top: 16rpx;
  border-radius: 6rpx;
  background: #74805d;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}

/* 门店区域：控制门店图片、地址和营业信息。 */
.store-select {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

.down-icon {
  font-size: 26rpx;
}

.pin-icon {
  position: relative;
  width: 26rpx;
  height: 34rpx;
  border: 4rpx solid #41452d;
  border-radius: 18rpx 18rpx 18rpx 4rpx;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.pin-icon::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #41452d;
}

.bell-icon {
  position: relative;
  width: 34rpx;
  height: 38rpx;
  border: 4rpx solid #41452d;
  border-bottom: 0;
  border-radius: 20rpx 20rpx 8rpx 8rpx;
  box-sizing: border-box;
}

.bell-icon::after {
  content: '';
  position: absolute;
  left: -6rpx;
  bottom: -8rpx;
  width: 38rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #41452d;
}

.delivery-strip {
  height: 78rpx;
  margin-top: 62rpx;
  padding: 0 34rpx 0 24rpx;
  border: 2rpx solid rgba(202, 180, 144, 0.62);
  border-radius: 34rpx;
  background: rgba(255, 248, 235, 0.42);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.delivery-img {
  width: 128rpx;
  height: 84rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.delivery-text {
  flex: 1;
  color: #655d4c;
  font-size: 25rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.delivery-link {
  color: #4b4f33;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* 购物袋区域：控制底部金额、数量和结算按钮。 */
.cart-card {
  margin-top: 24rpx;
  padding: 20rpx 26rpx;
  border: 2rpx solid rgba(202, 180, 144, 0.62);
  border-radius: 26rpx;
  background: rgba(255, 248, 235, 0.38);
}

.empty-box {
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 16rpx;
  color: #7b705f;
  font-size: 24rpx;
}


.cart-items-scroll {
  width: 100%;
}

.cart-items-scroll.is-scroll {
  height: 430rpx;
}
.cart-item {
  position: relative;
  min-height: 208rpx;
  padding: 24rpx 0 24rpx 74rpx;
  border-bottom: 2rpx solid rgba(202, 180, 144, 0.48);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.cart-item:last-child {
  border-bottom: 0;
}

.select-dot {
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid #74805d;
  border-radius: 50%;
  color: transparent;
  background: transparent;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
  box-sizing: border-box;
}

.cart-item > .select-dot {
  position: absolute;
  left: 6rpx;
  top: 50%;
  transform: translateY(-50%);
}

.select-dot.checked {
  color: #fff8ec;
  background: #74805d;
}

.item-img {
  width: 210rpx;
  height: 150rpx;
  margin-right: 28rpx;
  border-radius: 18rpx;
  background: rgba(255, 248, 235, 0.4);
  flex-shrink: 0;
}

.item-info {
  min-width: 0;
  flex: 1;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.item-name {
  color: #40442d;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.item-spec {
  margin-top: 16rpx;
  color: #6d6656;
  font-size: 24rpx;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-price {
  margin-top: 34rpx;
  color: #3f422d;
  font-size: 32rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.delete-icon {
  position: absolute;
  right: 18rpx;
  top: 34rpx;
  width: 28rpx;
  height: 34rpx;
  border: 4rpx solid #7a6043;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  box-sizing: border-box;
}

.delete-icon::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: -8rpx;
  width: 36rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #7a6043;
}

.item-stepper {
  position: absolute;
  right: 0;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.step-btn {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}

.step-btn.minus {
  border: 2rpx solid #9b7a4c;
  color: #7a6043;
}

.step-btn.plus {
  color: #fff8ec;
  background: #74805d;
}

.item-qty {
  min-width: 24rpx;
  color: #3f422d;
  font-size: 32rpx;
  line-height: 46rpx;
  text-align: center;
}

.section-title {
  margin: 40rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #40442d;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.leaf-mark {
  color: #74805d;
  font-size: 28rpx;
}

.leaf-mark.right {
  transform: scaleX(-1);
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.recommend-card {
  position: relative;
  min-height: 390rpx;
  padding: 16rpx 20rpx 20rpx;
  border: 2rpx solid rgba(202, 180, 144, 0.62);
  border-radius: 18rpx;
  background: rgba(255, 248, 235, 0.38);
  box-sizing: border-box;
}

.recommend-img {
  width: 100%;
  height: 210rpx;
}

.recommend-name {
  display: block;
  margin-top: 8rpx;
  color: #40442d;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.recommend-desc {
  display: block;
  margin-top: 6rpx;
  color: #7b705f;
  font-size: 22rpx;
  line-height: 28rpx;
}

.recommend-price {
  display: block;
  margin-top: 8rpx;
  color: #4c4f34;
  font-size: 26rpx;
  line-height: 30rpx;
  font-weight: 800;
}

.recommend-add {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #74805d;
  color: #fff8ec;
  font-size: 36rpx;
  line-height: 54rpx;
  text-align: center;
}

.discount-card {
  margin-top: 56rpx;
  border: 2rpx solid rgba(202, 180, 144, 0.62);
  border-radius: 20rpx;
  background: rgba(255, 248, 235, 0.36);
  overflow: hidden;
}

.discount-row {
  height: 70rpx;
  padding: 0 28rpx;
  border-bottom: 2rpx solid rgba(202, 180, 144, 0.35);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.discount-row:last-child {
  border-bottom: 0;
}

.ticket-icon {
  width: 44rpx;
  color: #4d5238;
  font-size: 28rpx;
}

.discount-title {
  color: #40442d;
  font-size: 28rpx;
  font-weight: 800;
}

.discount-right,
.points-text {
  margin-left: auto;
  color: #6f6758;
  font-size: 23rpx;
}

.points-switch-wrap {
  margin-left: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mock-switch {
  width: 86rpx;
  height: 48rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #cfc3a7;
  box-sizing: border-box;
}

.mock-switch.active {
  background: #74805d;
}

.mock-switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff8ec;
  box-shadow: 0 2rpx 8rpx rgba(76, 66, 44, 0.2);
  transform: translateX(0);
}

.mock-switch.active .mock-switch-dot {
  transform: translateX(38rpx);
}

.settle-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 80rpx;
  z-index: 38;
  min-height: calc(150rpx + env(safe-area-inset-bottom));
  padding: 20rpx 34rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  background: rgba(255, 248, 235, 0.98);
  box-shadow: 0 -10rpx 28rpx rgba(113, 92, 55, 0.12);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #40442d;
  font-size: 30rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.select-dot.all {
  position: static;
  transform: none;
}

.total-box {
  width: 260rpx;
  margin-left: auto;
  margin-right: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.total-label {
  color: #4a4d34;
  font-size: 22rpx;
  line-height: 24rpx;
}

.total-price {
  margin-top: 3rpx;
  color: #40442d;
  font-size: 40rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.settle-safe {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #7a8264;
  font-size: 22rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.safe-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.checkout-btn {
  width: 222rpx;
  height: 76rpx;
  border-radius: 40rpx;
  background: #74805d;
  color: #fff8ec;
  font-size: 32rpx;
  line-height: 76rpx;
  font-weight: 900;
  text-align: center;
  flex-shrink: 0;
}

.location-icon {
  width: 44rpx;
  height: 54rpx;
  flex-shrink: 0;
}

.bell-image {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.delivery-img {
  width: 128rpx;
  height: 84rpx;
  margin-right: 22rpx;
}

.delete-image {
  position: absolute;
  right: 12rpx;
  top: 28rpx;
  width: 45rpx;
  height: 45rpx;
  z-index: 2;
}

.discount-icon {
  width: 58rpx;
  height: 58rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.points-icon {
  width: 60rpx;
  height: 60rpx;
}

.section-leaf {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  transform: rotate(-40deg);
}

.section-leaf.right {
  transform: rotate(40deg);
}
/* 底部导航：控制 tab 图标、文字和选中状态。 */
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150rpx;
  padding: 18rpx 34rpx calc(16rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  border-top: 2rpx solid rgba(205, 187, 151, 0.46);
  background: #fff8ea;
  box-shadow: 0 -10rpx 28rpx rgba(84, 70, 44, 0.1);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  z-index: 40;
}

.nav-item {
  width: 112rpx;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5e5847;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.nav-item.active {
  color: #4f5e40;
  font-weight: 900;
}

.nav-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}
