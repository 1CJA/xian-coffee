/* 门店详情页样式：控制门店图片、信息卡和视频区域。 */
/* 页面样式配置 */
/* 页面基础样式：设置背景色、字体颜色和最小高度。 */
page {
  min-height: 100vh;
  background: #F4EAD9;
  color: #40452f;
}

/* 页面主容器：控制整体间距、背景和安全区域。 */
.store-page {
  min-height: 100vh;
  padding: 54rpx 30rpx 54rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

.topbar {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn,
.top-placeholder {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  width: 52rpx;
  height: 52rpx;
}

.top-title {
  color: #3f462f;
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

/* 品牌元素：控制 logo、标题和英文标识样式。 */
.brand-title {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-name {
  color: #3e452d;
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
}


.brand-en {
  margin-top: 8rpx;
  display: block;
  text-align: center;
  color: #596046;
  font-size: 22rpx;
  line-height: 30rpx;
  letter-spacing: 7rpx;
}

/* 门店区域：控制门店图片、地址和营业信息。 */
.store-hero {
  width: 100%;
  height: 420rpx;
  margin-top: 30rpx;
  border-radius: 34rpx;
  display: block;
  overflow: hidden;
}

.store-card,
.info-card {
  border: 2rpx solid rgba(180, 157, 118, 0.58);
  border-radius: 30rpx;
  background: #F4EAD9;
  box-sizing: border-box;
}

.store-card {
  margin-top: 24rpx;
  padding: 24rpx 24rpx 24rpx;
}

.store-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.store-name-wrap {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.store-name {
  color: #3d442d;
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.store-distance {
  margin-top: 10rpx;
  color: #7b735e;
  font-size: 24rpx;
  line-height: 32rpx;
}

.rating {
  height: 48rpx;
  padding: 0 14rpx;
  border-radius: 24rpx;
  background: rgba(231, 218, 193, 0.82);
  color: #4d533a;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 27rpx;
  line-height: 48rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.star-icon {
  width: 28rpx;
  height: 28rpx;
}



.service-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.service-item {
  width: 194rpx;
  height: 78rpx;
  border-radius: 40rpx;
  background: #e9dfc9;
  color: #40462f;
  font-size: 29rpx;
  line-height: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.service-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.info-card {
  margin-top: 22rpx;
  padding: 4rpx 22rpx;
}

.info-row,
.intro-row {
  min-height: 92rpx;
  border-bottom: 2rpx dashed rgba(177, 154, 118, 0.46);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.intro-row {
  min-height: 146rpx;
  border-bottom: none;
  align-items: flex-start;
  padding: 28rpx 0 26rpx;
}

.info-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info-label {
  color: #3f452f;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 900;
  white-space: nowrap;
}

.info-value {
  min-width: 0;
  flex: 1;
  margin-left: 28rpx;
  color: #6d6657;
  font-size: 27rpx;
  line-height: 38rpx;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-arrow {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.intro-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.intro-text {
  margin-top: 12rpx;
  color: #706858;
  font-size: 26rpx;
  line-height: 38rpx;
}

/* 操作按钮：控制页面内按钮排列和状态。 */
.action-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-item {
  width: 210rpx;
  height: 152rpx;
  border: 2rpx solid rgba(202, 183, 149, 0.62);
  border-radius: 28rpx;
  background: #f5ead4;
  color: #414632;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(98, 78, 46, 0.08);
  box-sizing: border-box;
}

.action-item text {
  color: #414632;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.env-section {
  margin-top: 34rpx;
}

.section-head {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #3f452d;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}


.env-list {
  margin-top: 20rpx;
  display: flex;
  gap: 18rpx;
}

.env-img {
  flex: 1;
  min-width: 0;
  height: 310rpx;
  border-radius: 24rpx;
  display: block;
  overflow: hidden;
}

/* 视频区域：控制门店视频组件的尺寸和间距。 */
.video-section {
  margin-top: 34rpx;
}

.video-head {
  justify-content: flex-start;
}

.store-video {
  width: 100%;
  height: 424rpx;
  margin-top: 18rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e9dfc9;
  display: block;
}
@media (max-width: 360px) {
  .store-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .brand-name {
    font-size: 42rpx;
    letter-spacing: 5rpx;
  }

  .service-item {
    width: 176rpx;
  }

  .action-item {
    width: 190rpx;
  }
}