/* 优惠券页样式：控制券面布局、状态和按钮样式。 */
/* 页面样式配置 */
/* 页面基础样式：设置背景色、字体颜色和最小高度。 */
page {
  min-height: 100vh;
  background: #F4EAD9;
  color: #3f432e;
}

/* 页面主容器：控制整体间距、背景和安全区域。 */
.coupons-page {
  min-height: 100vh;
  padding: 74rpx 28rpx 42rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

.coupons-shell {
  min-height: calc(100vh - 116rpx);
  padding: 26rpx 28rpx 38rpx;
  border-radius: 58rpx;
  box-sizing: border-box;
  background: #F4EAD9;
}

.header-row {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn,
.header-space {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  color: #3f452f;
  font-size: 78rpx;
  line-height: 72rpx;
  font-weight: 300;
}

.title-area {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.title-leaf {
  width: 48rpx;
  height: 58rpx;
  flex-shrink: 0;
}

.title-leaf.left {
  transform: rotate(-32deg);
}

.title-leaf.right {
  transform: rotate(32deg) scaleX(-1);
}

.page-title {
  color: #3f452f;
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.subtitle {
  margin-top: 8rpx;
  color: #6d6555;
  font-size: 27rpx;
  line-height: 38rpx;
  text-align: center;
  letter-spacing: 5rpx;
}

.tabs-card {
  height: 80rpx;
  margin-top: 34rpx;
  border: 2rpx solid rgba(194, 174, 137, 0.62);
  border-radius: 20rpx;
  display: flex;
  overflow: hidden;
  box-sizing: border-box;
}

/* 标签切换：控制订单、优惠券等状态切换样式。 */
.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b6252;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
}

.tab-item.active {
  background: #74805f;
  color: #fff8ea;
  font-weight: 900;
}

.tab-line {
  position: absolute;
  bottom: 10rpx;
  width: 42rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #fff8ea;
}


.no-coupon-card {
  height: 92rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border: 2rpx solid rgba(181, 158, 120, 0.72);
  border-radius: 22rpx;
  background: rgba(255, 250, 239, 0.56);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.no-coupon-title {
  color: #3d432f;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.no-coupon-desc {
  margin-left: auto;
  color: #756e5e;
  font-size: 24rpx;
  line-height: 32rpx;
}
/* 优惠券区域：控制券面、金额和使用状态样式。 */
/* 优惠券区域：控制券面、金额和使用状态。 */
.coupon-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.coupon-card {
  position: relative;
  min-height: 286rpx;
  display: flex;
  border: 2rpx solid rgba(181, 158, 120, 0.72);
  border-radius: 24rpx;
  background: rgba(255, 250, 239, 0.56);
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 8rpx 18rpx rgba(92, 76, 45, 0.06);
}

.coupon-card.disabled {
  opacity: 0.7;
}

.side-strip {
  width: 112rpx;
  flex-shrink: 0;
  border-radius: 22rpx 0 0 22rpx;
  background: #7f896a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.coupon-card.gold .side-strip {
  background: #bd925b;
}

.side-text {
  width: 44rpx;
  color: #fff8ea;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 800;
  text-align: center;
}

.side-icon {
  width: 62rpx;
  height: 54rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
}

.coupon-body {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 34rpx 28rpx 24rpx 42rpx;
  box-sizing: border-box;
}

.coupon-copy {
  right: 33rpx;
  position: relative;
  z-index: 2;
  width: 342rpx;
  display: flex;
  flex-direction: column;
}

.coupon-title {
  color: #3d432f;
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.coupon-offer {
  margin-top: 22rpx;
  color: #404831;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 800;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-wrap: wrap;
}

.coupon-card.gold .coupon-offer {
  color: #8d6234;
}

.offer-big {
  font-size: 62rpx;
  line-height: 68rpx;
  font-weight: 900;
}

.dash-line {
  width: 300rpx;
  height: 2rpx;
  margin: 18rpx 0 18rpx;
  background-image: linear-gradient(to right, rgba(177, 154, 116, 0.68) 0, rgba(177, 154, 116, 0.68) 12rpx, transparent 12rpx, transparent 22rpx);
  background-size: 22rpx 2rpx;
}

.rule-line {
  color: #6e6757;
  font-size: 22rpx;
  line-height: 32rpx;
}

.condition {
  width: 330rpx;
}

.coupon-art {
  position: absolute;
 left: 270rpx;
  top: 20rpx;
  width: 280rpx;
  height: 210rpx;
  z-index: 1;
}

.use-btn,
.used-btn {
  position: absolute;
  right: 30rpx;
  bottom: 26rpx;
  width: 164rpx;
  height: 56rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.use-btn {
  background: #74805f;
  color: #fff8ea;
}

.coupon-card.gold .use-btn {
  background: #ad7f46;
}

.used-btn {
  border: 2rpx solid #8b846e;
  color: #77705f;
  background: rgba(255, 250, 239, 0.7);
}

.footer-note {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #756e5e;
  font-size: 25rpx;
  line-height: 34rpx;
}

.note-leaf {
  width: 46rpx;
  height: 52rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  transform: rotate(-20deg);
}

@media (max-width: 360px) {
  .coupons-page {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .coupons-shell {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .coupon-card {
    min-height: 300rpx;
  }

  .coupon-copy {
    width: 318rpx;
  }

  .coupon-art {
    width: 218rpx;
    right: 8rpx;
  }
}